# =============================================================================
# Personalized E-Commerce Recommendation System - Environment Configuration
# =============================================================================

# Flask Application
FLASK_APP=backend.app:create_app
FLASK_ENV=development
PORT=5000

# Security Keys (Replace with strong random 256-bit keys in production)
SECRET_KEY=change_this_to_a_secure_random_key_in_production_min_32_chars
JWT_SECRET_KEY=change_this_to_a_secure_jwt_key_in_production_min_32_chars

# Database Configuration (SQLite default; PostgreSQL ready)
# SQLite: sqlite:///data/ecommerce.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/ecommerce_db
DATABASE_URL=sqlite:///data/ecommerce.db

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Recommendation System Parameters
DEFAULT_HYBRID_ALPHA=0.25
DEFAULT_RECOMMENDATION_K=10
MIN_INTERACTIONS_USER=3
MIN_INTERACTIONS_PRODUCT=3

# Directory Paths (Relative or Absolute)
DATA_DIR=data
MODELS_DIR=models
REPORTS_DIR=reports
