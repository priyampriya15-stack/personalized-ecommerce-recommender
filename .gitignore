# =============================================================================
# Git Ignore - Personalized E-Commerce Recommendation System
# =============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Python Caches & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
virtualenv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# SQLite Database & Runtime Data
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# Trained Model Binaries (Reproducible via scripts/train_models.py)
models/*.joblib
models/*.pkl
models/*.pt
models/*.pth
!models/.gitkeep
!models/training_metadata.json

# Large Generated Datasets (Reproducible via scripts/preprocess_data.py)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/preprocessing_metadata.json

# Node & Frontend Build
node_modules/
dist/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Jupyter & Editor / OS files
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.vscode/
.idea/
